#!/bin/sh
# LeakOS Live Initramfs Init Script
# Clean version - hanya mounting dan switch_root

export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export HOME=/

# Warna untuk output (optional)
if [ -t 1 ] 2>/dev/null; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; NC=''
fi

# ============================================
# Fungsi utilitas
# ============================================

log() {
    echo "${GREEN}[INIT]${NC} $*" > /dev/kmsg 2>/dev/null || echo "[INIT] $*"
}

warn() {
    echo "${YELLOW}[WARN]${NC} $*" > /dev/kmsg 2>/dev/null || echo "[WARN] $*"
}

error() {
    echo "${RED}[ERROR]${NC} $*" > /dev/kmsg 2>/dev/null || echo "[ERROR] $*"
}

emergency_shell() {
    echo ""
    echo "${RED}========================================${NC}"
    echo "${RED}  EMERGENCY SHELL${NC}"
    echo "${RED}========================================${NC}"
    echo "Masukkan perintah untuk debugging:"
    echo "  lsblk, blkid, mount, dmesg, cat /proc/cmdline"
    echo "========================================${NC}"
    echo ""
    exec /bin/sh
}

# ============================================
# Mount basic filesystems
# ============================================

mount_base() {
    log "Mounting base filesystems..."
    
    mount -t devtmpfs devtmpfs /dev 2>/dev/null || error "devtmpfs failed"
    mount -t proc proc /proc 2>/dev/null || error "proc failed"
    mount -t sysfs sysfs /sys 2>/dev/null || error "sysfs failed"
    mount -t tmpfs tmpfs /run 2>/dev/null || warn "tmpfs /run failed"
    mount -t tmpfs tmpfs /tmp 2>/dev/null || warn "tmpfs /tmp failed"
    
    mkdir -p /dev/pts 2>/dev/null
    mount -t devpts devpts /dev/pts -o gid=5,mode=620 2>/dev/null || warn "devpts failed"
    
    log "Base filesystems ready"
}

# ============================================
# Load kernel modules
# ============================================

load_modules() {
    log "Loading kernel modules..."
    
    # Core modules untuk live system
    for mod in squashfs overlay loop; do
        modprobe -q "$mod" 2>/dev/null && log "  Loaded: $mod" || warn "  Failed: $mod"
    done
    
    # Filesystem modules untuk boot media
    for mod in vfat exfat iso9660 ext4 xfs btrfs; do
        modprobe -q "$mod" 2>/dev/null
    done
    
    # Storage drivers
    for mod in usb_storage sr_mod ahci nvme virtio_blk mmc_block; do
        modprobe -q "$mod" 2>/dev/null
    done
    
    # Host controllers
    for mod in xhci_hcd ehci_hcd uhci_hcd; do
        modprobe -q "$mod" 2>/dev/null
    done
}

# ============================================
# Setup loop devices
# ============================================

setup_loop_devices() {
    log "Setting up loop devices..."
    
    # Hapus existing loop devices
    for i in 0 1 2 3 4 5 6 7; do
        if [ ! -b "/dev/loop$i" ]; then
            mknod -m 660 "/dev/loop$i" b 7 "$i" 2>/dev/null
        fi
    done
}

# ============================================
# Start udev
# ============================================

start_udev() {
    log "Starting udev..."
    
    # Cari udevd
    UDEVD=""
    for p in /usr/lib/systemd/systemd-udevd /usr/lib/udev/udevd /sbin/udevd /usr/sbin/udevd; do
        if [ -x "$p" ]; then
            UDEVD="$p"
            break
        fi
    done
    
    if [ -z "$UDEVD" ]; then
        warn "udevd not found, skipping udev"
        return
    fi
    
    $UDEVD --daemon --resolve-names=never 2>/dev/null
    udevadm trigger --action=add 2>/dev/null
    udevadm settle --timeout=30 2>/dev/null
    
    log "udev ready"
}

# ============================================
# Parse kernel command line
# ============================================

parse_cmdline() {
    if [ -r /proc/cmdline ]; then
        for param in $(cat /proc/cmdline); do
            case "$param" in
                debug)
                    log "Debug mode enabled"
                    set -x
                    ;;
                rootdelay=*)
                    delay="${param#rootdelay=}"
                    log "Root delay: ${delay}s"
                    sleep "$delay"
                    ;;
            esac
        done
    fi
}

# ============================================
# Cari boot media dengan lfs.squashfs
# ============================================

find_boot_media() {
    local BOOT_MNT="/bootmnt"
    local timeout=60
    local elapsed=0
    
    log "Searching for boot media (timeout: ${timeout}s)..."
    
    mkdir -p "$BOOT_MNT" 2>/dev/null
    
    while [ $elapsed -lt $timeout ]; do
        # Scan semua block devices
        for dev in $(ls /sys/block/ 2>/dev/null); do
            # Skip loop, ram, dm devices
            case "$dev" in
                loop*|ram*|dm-*) continue ;;
            esac
            
            # Cek partitions dulu
            for part in /dev/${dev}p[0-9]* /dev/${dev}[0-9]* 2>/dev/null; do
                [ -b "$part" ] || continue
                
                # Coba mount dengan berbagai filesystem
                for fstype in iso9660 vfat exfat ext4 ext3 ext2; do
                    if mount -t "$fstype" -o ro "$part" "$BOOT_MNT" 2>/dev/null; then
                        if [ -f "$BOOT_MNT/boot/lfs.squashfs" ]; then
                            log "Found boot media: $part (partition)"
                            echo "$part"
                            return 0
                        fi
                        umount "$BOOT_MNT" 2>/dev/null
                    fi
                done
            done
            
            # Cek whole disk (untuk optical media atau superfloppy)
            if [ -b "/dev/$dev" ]; then
                for fstype in iso9660 udf; do
                    if mount -t "$fstype" -o ro "/dev/$dev" "$BOOT_MNT" 2>/dev/null; then
                        if [ -f "$BOOT_MNT/boot/lfs.squashfs" ]; then
                            log "Found boot media: /dev/$dev (whole disk)"
                            echo "/dev/$dev"
                            return 0
                        fi
                        umount "$BOOT_MNT" 2>/dev/null
                    fi
                done
            fi
        done
        
        sleep 2
        elapsed=$((elapsed + 2))
        [ $((elapsed % 10)) -eq 0 ] && log "Still searching... (${elapsed}s)"
    done
    
    return 1
}

# ============================================
# Mount root filesystem (squashfs + overlay)
# ============================================

mount_root() {
    local BOOT_MNT="/bootmnt"
    local SQUASH_MNT="/squashfs"
    local ROOT_MNT="/newroot"
    local COW_DIR="/cow"
    local UPPER_DIR="$COW_DIR/upper"
    local WORK_DIR="$COW_DIR/work"
    
    log "Mounting root filesystem..."
    
    # Buat direktori yang diperlukan
    mkdir -p "$BOOT_MNT" "$SQUASH_MNT" "$ROOT_MNT" "$COW_DIR" "$UPPER_DIR" "$WORK_DIR"
    
    # Cari boot media
    BOOT_DEV=$(find_boot_media)
    if [ -z "$BOOT_DEV" ]; then
        error "Boot media with lfs.squashfs not found!"
        error "Available devices:"
        lsblk 2>/dev/null || cat /proc/partitions
        return 1
    fi
    
    log "Boot device: $BOOT_DEV"
    
    # Mount boot media
    if ! mount -t auto -o ro "$BOOT_DEV" "$BOOT_MNT"; then
        error "Failed to mount $BOOT_DEV"
        return 1
    fi
    
    log "Boot media mounted at $BOOT_MNT"
    
    # Verifikasi lfs.squashfs
    if [ ! -f "$BOOT_MNT/boot/lfs.squashfs" ]; then
        error "lfs.squashfs not found in $BOOT_MNT/boot/"
        error "Contents of $BOOT_MNT/boot/:"
        ls -la "$BOOT_MNT/boot/" 2>/dev/null
        return 1
    fi
    
    log "Found lfs.squashfs"
    
    # Mount squashfs
    if ! mount -t squashfs -o loop "$BOOT_MNT/boot/lfs.squashfs" "$SQUASH_MNT"; then
        error "Failed to mount squashfs"
        return 1
    fi
    
    log "Squashfs mounted at $SQUASH_MNT"
    
    # Mount tmpfs untuk overlay (writable layer)
    if ! mount -t tmpfs tmpfs "$COW_DIR"; then
        error "Failed to mount tmpfs for overlay"
        return 1
    fi
    
    log "Tmpfs mounted at $COW_DIR"
    
    # Mount overlay filesystem
    if ! mount -t overlay overlay -o lowerdir="$SQUASH_MNT",upperdir="$UPPER_DIR",workdir="$WORK_DIR" "$ROOT_MNT"; then
        error "Failed to mount overlay"
        return 1
    fi
    
    log "Overlay mounted at $ROOT_MNT"
    
    # Bind mount boot media untuk akses nanti
    mkdir -p "$ROOT_MNT/mnt/bootmedia" 2>/dev/null
    mount --bind "$BOOT_MNT" "$ROOT_MNT/mnt/bootmedia" 2>/dev/null || warn "Failed to bind mount boot media"
    
    # Pindahkan pseudo-filesystems ke new root
    mount --move /dev "$ROOT_MNT/dev" 2>/dev/null || warn "Failed to move /dev"
    mount --move /proc "$ROOT_MNT/proc" 2>/dev/null || warn "Failed to move /proc"
    mount --move /sys "$ROOT_MNT/sys" 2>/dev/null || warn "Failed to move /sys"
    mount --move /run "$ROOT_MNT/run" 2>/dev/null || warn "Failed to move /run"
    
    # Pastikan /dev/pts ada
    mkdir -p "$ROOT_MNT/dev/pts" 2>/dev/null
    mount -t devpts devpts "$ROOT_MNT/dev/pts" -o gid=5,mode=620 2>/dev/null || warn "devpts in newroot failed"
    
    log "Root filesystem ready at $ROOT_MNT"
    
    # Export ROOT_MNT untuk fungsi lain
    echo "$ROOT_MNT"
    return 0
}

# ============================================
# Cari init di new root
# ============================================

find_root_init() {
    local ROOT_MNT="$1"
    
    # Priority order untuk init
    for init in \
        /sbin/init \
        /usr/sbin/init \
        /bin/init \
        /usr/bin/init \
        /usr/lib/systemd/systemd \
        /lib/systemd/systemd \
        /sbin/openrc-init \
        /etc/init \
        /init
    do
        if [ -x "$ROOT_MNT$init" ]; then
            log "Found init: $init"
            echo "$init"
            return 0
        fi
    done
    
    # Fallback ke /bin/sh jika ada
    if [ -x "$ROOT_MNT/bin/sh" ]; then
        warn "No proper init found, falling back to /bin/sh"
        echo "/bin/sh"
        return 0
    fi
    
    return 1
}

# ============================================
# Cleanup sebelum switch_root
# ============================================

cleanup() {
    log "Cleaning up..."
    
    # Stop udev
    killall udevd 2>/dev/null
    killall systemd-udevd 2>/dev/null
    
    # Unmount sementara yang tidak perlu
    umount /dev/pts 2>/dev/null
}

# ============================================
# MAIN
# ============================================

log "=== LeakOS Live Initramfs Starting ==="

# Mount base filesystems
mount_base

# Parse kernel command line
parse_cmdline

# Load kernel modules
load_modules

# Setup loop devices
setup_loop_devices

# Start udev
start_udev

# Mount root filesystem
ROOT_MNT=$(mount_root)
if [ -z "$ROOT_MNT" ]; then
    error "Failed to mount root filesystem"
    emergency_shell
    panic "Cannot proceed without root filesystem"
fi

# Cari init di new root
ROOT_INIT=$(find_root_init "$ROOT_MNT")
if [ -z "$ROOT_INIT" ]; then
    error "No valid init found in $ROOT_MNT!"
    error "Contents of /sbin:"
    ls -la "$ROOT_MNT/sbin" 2>/dev/null | head -10
    error "Contents of /usr/sbin:"
    ls -la "$ROOT_MNT/usr/sbin" 2>/dev/null | head -10
    emergency_shell
    panic "Cannot find init"
fi

# Cleanup
cleanup

# Final log
log "Switching to new root with init: $ROOT_INIT"

# Switch to new root
exec switch_root "$ROOT_MNT" "$ROOT_INIT"

# Jika sampai sini, switch_root gagal
error "switch_root failed!"
emergency_shell
panic "switch_root failed"
